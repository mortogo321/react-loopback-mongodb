{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@fortawesome/fontawesome-free": "7.3.1",
    "@rematch/core": "2.2.0",
    "@rematch/loading": "2.1.2",
    "@rematch/persist": "2.1.2",
    "alertifyjs": "1.14.0",
    "axios": "1.19.0",
    "bootstrap": "5.3.8",
    "formik": "2.4.9",
    "moment": "2.30.1",
    "sass": "^1.97.3",
    "npm-run-all": "4.1.5",
    "react": "19.2.8",
    "react-datepicker": "9.1.0",
    "react-dom": "19.2.8",
    "react-redux": "9.3.0",
    "react-router-dom": "7.18.2",
    "react-scripts": "5.0.1",
    "react-transition-group": "4.4.5",
    "reactstrap": "9.2.3",
    "redux": "5.0.1"
  },
  "scripts": {
    "build-css": "sass --no-source-map --load-path=./src/assets/scss/ --load-path=./node_modules/ ./src/assets/scss/:./src/assets/css/",
    "watch-css": "bun run build-css && sass --no-source-map --load-path=./src/assets/scss/ --load-path=./node_modules/ ./src/assets/scss/:./src/assets/css/ --watch",
    "start-js": "react-scripts start",
    "start": "npm-run-all -p watch-css start-js",
    "build-js": "react-scripts build",
    "move-assets": "rm -rf ../server/client && mv build ../server/client",
    "build": "npm-run-all build-css build-js move-assets",
    "test": "react-scripts test --env=jsdom",
    "eject": "react-scripts eject"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
